# ============================================================
# Clever Way Media — környezeti változók
# FONTOS: ezek az értékek MÁR alapértelmezettként be vannak
# égetve a kódba (src/lib/site.ts), tehát ezt a fájlt
# NEM kötelező kitölteni — a weboldal ezek nélkül is működik.
#
# Csak akkor tölts ki bármit, ha módosítani szeretnél valamit
# (pl. új Formspree endpoint, más Cal.com esemény, LinkedIn hozzáadása).
#
# Ha mégis használod: másold ".env.local" néven a projekt
# gyökerébe, majd Vercelen: Settings → Environment Variables.
# ============================================================

NEXT_PUBLIC_SITE_URL=https://www.cleverwaymedia.de

# Booking (Cal.com) — jelenlegi alapérték: cal.eu/cleverwaymedia
NEXT_PUBLIC_CALCOM_LINK=cleverwaymedia
NEXT_PUBLIC_CALCOM_ORIGIN=https://cal.eu

# Kontakt-űrlap (Formspree) — jelenlegi alapérték már be van kötve
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mlgyvzne

# Közösségi média
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=100091651446199
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cleverwaymedia
NEXT_PUBLIC_LINKEDIN_URL=
